# Copy to deploy/.env on the server, chmod 600. Never commit the filled file.
#
# This file is the second half of a restore: the database comes from the
# replica, but a new host cannot be brought up without these values. Keep a
# copy in a password manager and use that copy for the restore drill (task 5.1)
# — a secret that exists only on the host you are recovering from is not backed up.

# --- application (read only by the app container) -----------------------------
HEMA_SQUIRE_SECRET_KEY=            # openssl rand -hex 32
HEMA_SQUIRE_OWNER_EMAIL=
HEMA_SQUIRE_ANTHROPIC_API_KEY=     # table-import LLM path; empty disables it
# Sheets export: place the service-account JSON at deploy/secrets/ on the
# server and point this at its path inside the container. Empty disables the
# export; the bind mount tolerates an empty directory.
HEMA_SQUIRE_GOOGLE_CREDENTIALS_PATH=   # e.g. /secrets/google-credentials.json

# --- email (presence of SMTP_HOST selects the real mailer; task 1.6) ---------
HEMA_SQUIRE_EMAIL_SENDER=noreply@hemasquire.eu
HEMA_SQUIRE_SMTP_HOST=
HEMA_SQUIRE_SMTP_PORT=587
HEMA_SQUIRE_SMTP_USER=
HEMA_SQUIRE_SMTP_PASSWORD=

# --- web (passed to Caddy alone) ----------------------------------------------
SITE_ADDRESS=hemasquire.eu

# --- backup replica (passed to Litestream alone; keys scoped to this bucket) ---
REPLICA_ENDPOINT=                  # e.g. https://<account>.r2.cloudflarestorage.com
REPLICA_BUCKET=hema-squire-replica
REPLICA_REGION=auto                # R2: auto. B2: the bucket's region, e.g. us-west-004
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
